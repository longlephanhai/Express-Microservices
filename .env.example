# Application Ports
PORT=3000
GATEWAY_PORT=3000
BRAND_PORT=3001
CATEGORY_PORT=3002
PRODUCT_PORT=3003
USER_PORT=3004
CART_PORT=3005
ORDER_PORT=3006

# Upstream Service URLs (Used by API Gateway and Product Service)
BRAND_SERVICE_URL=http://localhost:3001
CATEGORY_SERVICE_URL=http://localhost:3002
PRODUCT_SERVICE_URL=http://localhost:3003
USER_SERVICE_URL=http://localhost:3004
CART_SERVICE_URL=http://localhost:3005
ORDER_SERVICE_URL=http://localhost:3006

# Database Configuration (AWS RDS MySQL / External MySQL)
# Khi deploy RDS bằng Terraform, gán DB_HOST bằng rds_address từ output của Terraform
DB_HOST=your-rds-endpoint.xxxxxx.ap-southeast-1.rds.amazonaws.com
DB_PORT=3306
DB_USERNAME=dbadmin
DB_PASSWORD=your_rds_password
DB_NAME=demo
DB_TYPE=mysql

# Database names per service (mặc định trỏ về demo nếu không tách DB)
DB_BRAND_NAME=demo
DB_CATEGORY_NAME=demo
DB_PRODUCT_NAME=demo
DB_USER_NAME=demo
DB_ORDER_NAME=demo
DB_CART_NAME=demo

# Authentication & Security
JWT_SECRET=just_jwt_secret_key
EXPIRATION_TIME=1h